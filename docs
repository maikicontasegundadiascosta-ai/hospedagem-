<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel de Hospedagem</title>
    <style>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { 
            background: #06080d; 
            color: #f1f5f9; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            margin: 0; 
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .fade-in { animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 0 0 rgba(88, 101, 242, 0.4); }
            70% { box-shadow: 0 0 0 6px rgba(88, 101, 242, 0); }
            100% { box-shadow: 0 0 0 0 rgba(88, 101, 242, 0); }
        }

        #app-screen {
            display: flex;
            width: 100%;
            max-width: 390px;
            min-height: 100vh;
            background: #06080d;
            flex-direction: column;
            justify-content: space-between;
            padding: 12px 10px 60px 10px;
        }

        .header {
            text-align: center;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid #121824;
        }
        .header h1 { font-size: 16px; margin: 0; color: #fff; font-weight: 600; letter-spacing: -0.2px; }
        .header p { font-size: 10px; color: #8b9bb4; margin: 2px 0 0 0; }

        .container-box {
            background: #0b0f17;
            border: 1px solid #141b29;
            border-radius: 10px;
            padding: 11px 12px;
            margin-bottom: 9px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.25);
        }

        label {
            display: block;
            font-size: 9px;
            font-weight: 700;
            color: #8b9bb4;
            margin-bottom: 4px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        select, input, textarea {
            width: 100%;
            background: #040609;
            border: 1px solid #141b29;
            color: #fff;
            padding: 7px 10px;
            border-radius: 6px;
            font-size: 11px;
            margin-bottom: 7px;
            outline: none;
            transition: all 0.2s ease;
        }
        select:focus, input:focus, textarea:focus { 
            border-color: #5865F2; 
            animation: pulseGlow 1.2s infinite;
        }

        .btn {
            width: 100%;
            padding: 8px;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            font-size: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-bottom: 6px;
            transition: all 0.15s ease;
        }
        .btn:hover { opacity: 0.92; transform: translateY(-1px); }
        .btn:active { transform: scale(0.96); }

        .btn-discord { background: #5865F2; color: #fff; }
        .btn-success { background: #10b981; color: #fff; }
        .btn-danger { background: #ef4444; color: #fff; }

        .alert-box {
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #34d399;
            padding: 7px 10px;
            border-radius: 6px;
            font-size: 10px;
            text-align: center;
            margin-top: 6px;
            display: none;
            font-weight: 500;
        }

        .command-item {
            background: #040609;
            border: 1px solid #141b29;
            border-radius: 6px;
            padding: 7px 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 6px;
        }
        .command-info { display: flex; align-items: center; gap: 6px; }
        .command-name { font-size: 11px; font-weight: 600; color: #fff; }
        .badge-ai { background: #121824; color: #8b9bb4; font-size: 8px; padding: 2px 5px; border-radius: 3px; font-weight: 700; border: 1px solid #1c2638; }
        .btn-delete { background: transparent; border: 1px solid rgba(239, 68, 68, 0.4); color: #ef4444; font-size: 9px; padding: 3px 7px; border-radius: 4px; cursor: pointer; }

        .nav-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: rgba(11, 15, 23, 0.92);
            backdrop-filter: blur(10px);
            border-top: 1px solid #141b29;
            display: flex;
            justify-content: space-around;
            padding: 7px 0;
            z-index: 100;
        }
        .nav-item {
            background: none;
            border: none;
            color: #8b9bb4;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
            padding: 5px 16px;
            border-radius: 4px;
        }
        .nav-item.active { color: #818cf8; background: rgba(129, 140, 248, 0.08); }

        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        .section-title { font-size: 9px; color: #f43f5e; margin-bottom: 3px; font-weight: 700; }
    </style>
</head>
<body>

    <div id="app-screen" class="fade-in">
        <div>
            <div class="header">
                <h1>Painel de Hospedagem</h1>
                <p>Gerenciamento de slots e comandos</p>
            </div>

            <!-- ABA BOTS -->
            <div id="tab-bots" class="tab-content active">
                <div class="container-box">
                    <label>Slot Ativo</label>
                    <select id="slot-select" onchange="mudarSlot()">
                        <option value="1">Slot de Bot [ 1 ]</option>
                        <option value="2">Slot de Bot [ 2 ]</option>
                        <option value="3" selected>Slot de Bot [ 3 ]</option>
                        <option value="4">Slot de Bot [ 4 ]</option>
                    </select>

                    <p id="config-slot-text" style="font-size: 10px; color: #818cf8; margin: 2px 0 8px 0; font-weight: 500;">Configurando: Slot 3</p>

                    <label>Token do Discord</label>
                    <input type="password" id="bot-token" placeholder="Cole o token do bot aqui...">

                    <button class="btn btn-success" onclick="ligarBotWisp()">Ligar / Atualizar Bot</button>
                    <button class="btn btn-danger" onclick="desligarBotWisp()">Desligar Slot</button>

                    <div id="status-msg" class="alert-box"></div>
                </div>
            </div>

            <!-- ABA COMANDOS -->
            <div id="tab-comandos" class="tab-content">
                <div class="container-box">
                    <p style="margin-top:0; font-weight:600; font-size:10px; color:#fff; margin-bottom:5px;" id="comando-slot-titulo">Novo Comando Slash (Slot 3)</p>
                    
                    <label>Nome do Comando</label>
                    <input type="text" id="cmd-name" placeholder="/comando">

                    <label>Script Javascript (Opcional)</label>
                    <textarea rows="2" id="cmd-script">const lat = Date.now() - interaction.createdTimestamp; return `Pong! Latência: ${lat}ms`;</textarea>

                    <label class="section-title">API de IA - Recomendado Groq (Opcional)</label>
                    <input type="text" id="cmd-ai-key" placeholder="Cole sua chave da API (Ex: gsk_...)">

                    <label>Modelo (Ex: llama-3.3-70b-versatile)</label>
                    <input type="text" id="cmd-ai-model" value="llama-3.3-70b-versatile">

                    <button class="btn btn-discord" onclick="adicionarComando()">Adicionar Comando</button>
                </div>

                <div class="container-box">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <span style="font-size: 9px; font-weight: 700; color: #8b9bb4; text-transform: uppercase;">Comandos Configurados</span>
                        <span style="font-size: 9px; font-weight: 700; color: #ef4444; cursor: pointer;" onclick="limparComandos()">LIMPAR TODOS</span>
                    </div>
                    
                    <div id="lista-comandos">
                        <div class="command-item">
                            <div class="command-info">
                                <span class="command-name">/iniciar v2</span>
                                <span class="badge-ai">AI</span>
                            </div>
                            <button class="btn-delete" onclick="this.parentElement.remove()">Excluir</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ABA TESTES -->
            <div id="tab-testes" class="tab-content">
                <div class="container-box" style="text-align: center; padding: 25px;">
                    <p style="color: #8b9bb4; font-size: 11px; margin: 0;">Logs e testes em tempo real.</p>
                </div>
            </div>
        </div>

        <div class="nav-bar">
            <button class="nav-item active" onclick="trocarAba('bots', this)">Bots</button>
            <button class="nav-item" onclick="trocarAba('comandos', this)">Comandos</button>
            <button class="nav-item" onclick="trocarAba('testes', this)">Testes</button>
        </div>
    </div>

    <script>
        // URL HTTPS direta via Serveo (sem avisos nem telas intermediárias)
        const API_URL = 'https://nexus-bot-panel.serveo.net';

        function trocarAba(aba, elemento) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            
            const target = document.getElementById('tab-' + aba);
            target.classList.add('active');
            elemento.classList.add('active');
        }

        function mudarSlot() {
            const slot = document.getElementById('slot-select').value;
            document.getElementById('config-slot-text').innerText = `Configurando: Slot ${slot}`;
            document.getElementById('comando-slot-titulo').innerText = `Novo Comando Slash (Slot ${slot})`;
            carregarStatusSlot(slot);
        }

        async function carregarStatusSlot(slot) {
            try {
                const response = await fetch(`${API_URL}/api/slot/${slot}`);
                const data = await response.json();
                if (data && data.token) {
                    document.getElementById('bot-token').value = data.token;
                } else {
                    document.getElementById('bot-token').value = '';
                }
            } catch (err) {}
        }

        async function ligarBotWisp() {
            const slot = document.getElementById('slot-select').value;
            const token = document.getElementById('bot-token').value;
            const msg = document.getElementById('status-msg');

            if (!token) {
                alert('Insira o token do bot!');
                return;
            }

            msg.style.display = 'block';
            msg.innerText = `Conectando Slot ${slot}...`;

            try {
                const response = await fetch(`${API_URL}/api/slot/${slot}/start`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token })
                });

                const data = await response.json();
                if (data.success) {
                    msg.innerText = data.message || `Bot ligado com sucesso!`;
                } else {
                    msg.innerText = `Erro: ${data.message}`;
                }
            } catch (err) {
                msg.innerText = `Erro de conexão com o servidor.`;
            }
        }

        async function desligarBotWisp() {
            const slot = document.getElementById('slot-select').value;
            const msg = document.getElementById('status-msg');
            
            msg.style.display = 'block';
            msg.innerText = `Desligando Slot ${slot}...`;

            try {
                const response = await fetch(`${API_URL}/api/slot/${slot}/stop`, { 
                    method: 'POST' 
                });
                const data = await response.json();
                if (data.success) {
                    document.getElementById('bot-token').value = '';
                    msg.innerText = data.message || `Slot ${slot} desligado.`;
                }
            } catch (err) {
                msg.innerText = `Erro ao desligar slot.`;
            }
        }

        function adicionarComando() {
            const nome = document.getElementById('cmd-name').value;
            if(!nome) return alert('Insira o nome do comando!');
            const lista = document.getElementById('lista-comandos');
            lista.innerHTML += `
                <div class="command-item">
                    <div class="command-info">
                        <span class="command-name">${nome}</span>
                        <span class="badge-ai">AI</span>
                    </div>
                    <button class="btn-delete" onclick="this.parentElement.remove()">Excluir</button>
                </div>
            `;
            document.getElementById('cmd-name').value = '';
        }

        function limparComandos() {
            document.getElementById('lista-comandos').innerHTML = '';
        }

        carregarStatusSlot(document.getElementById('slot-select').value);
    </script>
</body>
                            </html>
    
